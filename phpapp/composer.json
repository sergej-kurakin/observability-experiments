{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "guzzlehttp/promises": "^2.0",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.2",
        "open-telemetry/opentelemetry-auto-curl": "^0.0.2",
        "open-telemetry/opentelemetry-auto-guzzle": "^1.0",
        "open-telemetry/opentelemetry-auto-psr15": "^1.0",
        "open-telemetry/opentelemetry-auto-psr16": "^0.0.3",
        "open-telemetry/opentelemetry-auto-psr18": "^1.0",
        "open-telemetry/opentelemetry-auto-symfony": "1.0.0beta30",
        "open-telemetry/opentelemetry-propagation-server-timing": "^0.0.3",
        "open-telemetry/opentelemetry-propagation-traceresponse": "^0.0.4",
        "open-telemetry/sdk": "^1.2",
        "open-telemetry/symfony-sdk-bundle": "^0.0.26",
        "open-telemetry/transport-grpc": "^1.1",
        "php-http/httplug": "^2.4",
        "symfony/console": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.2.*",
        "symfony/http-client": "^7.2",
        "symfony/options-resolver": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/yaml": "7.2.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*"
        }
    }
}
